<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>1</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <max_execution_time>300</max_execution_time>
        </default>
        <hft_profile>
            <max_memory_usage>15000000000</max_memory_usage>
            <max_threads>8</max_threads>
            <max_execution_time>60</max_execution_time>
            <readonly>0</readonly>
        </hft_profile>
    </profiles>
    
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
        </default>
        <satoshi_app>
            <password></password>
            <profile>hft_profile</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
            <databases>
                <database>satoshi_tsdb</database>
            </databases>
        </satoshi_app>
    </users>
    
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
